# Copy this file to .env and fill in real values. Never commit .env.

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
DATABASE_URL=sqlite:///./app.db

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- LLM provider ---
# "mock" requires no API key and produces deterministic-ish fake evaluations.
# "xai" calls xAI's Grok API -- get a key at https://console.x.ai (note: xAI
#   keys start with "xai-"; keys starting with "gsk_" are Groq keys, not xAI).
# "groq" calls the Groq API (free tier) -- get a key at https://console.groq.com/keys
#   (Groq and xAI/Grok are different services -- don't mix up the keys.)
# "anthropic" calls the real Claude API and requires ANTHROPIC_API_KEY.
LLM_PROVIDER=xai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
GROQ_API_KEY=
# llama-3.3-70b-versatile is free-tier available and gives the best evaluation
# quality. If you hit free-tier rate limits, switch to llama-3.1-8b-instant
# (faster, smaller, higher free-tier throughput, slightly lower quality).
GROQ_MODEL=llama-3.3-70b-versatile
XAI_API_KEY=
# grok-4-fast is a good cost/quality balance for this structured-extraction
# task. Check https://docs.x.ai/docs/models for the current model catalog if
# this ID stops working for your account.
XAI_MODEL=grok-4-fast

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
